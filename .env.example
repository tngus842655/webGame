# Supabase 프로젝트 설정 (Project Settings → Data API / API Keys)
# 실제 값은 .env.local에 넣는다 (git에 커밋되지 않음)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=anon-key

# H5 Games Ads(AdSense) 게시자 ID. 웹과 앱인토스에서만 쓴다.
# 비워두면 리워드 광고가 5초 카운트다운 스텁으로 떨어진다.
VITE_ADSENSE_CLIENT=ca-pub-0000000000000000

# AdMob 리워드 광고 단위 ID. 안드로이드 앱 빌드에서만 쓴다 —
# AdSense는 웹사이트용이라 앱 웹뷰에서 게재하면 정책 위반이다.
# 아래는 구글이 공개한 테스트용 단위이고, 실제 값은 AdMob 콘솔에서 받는다.
# 실제 값으로 바꿀 때 android/app/src/main/AndroidManifest.xml의 앱 ID도 같이 바꾼다.
VITE_ADMOB_REWARD_ID=ca-app-pub-3940256099942544/5224354917
