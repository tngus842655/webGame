# 릴리스 서명 정보. 이 파일을 keystore.properties로 복사해서 실제 값을 넣는다.
# keystore.properties와 .keystore 파일은 gitignore되어 있다 — 절대 커밋하지 말 것.
#
# storeFile은 이 파일 기준 상대 경로도 되고 절대 경로도 된다.
# TWA 때 쓰던 android.keystore를 그대로 써야 한다. 다른 키로 서명하면 Play가
# 업로드를 거부하고, 잃어버리면 이 패키지는 영영 업데이트할 수 없다.

storeFile=C:/Workspace/MiniGame30-TWA/android.keystore
storePassword=
keyAlias=android
keyPassword=
