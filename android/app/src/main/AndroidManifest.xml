<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 소셜 로그인 복귀용. 로그인 창은 앱 웹뷰가 아니라 크롬 커스텀 탭에서 열리고
                 (구글이 웹뷰 안 OAuth를 차단한다) 끝나면 이 스킴으로 앱에 돌아온다.
                 스킴을 바꾸면 Supabase의 Redirect URLs도 같이 바꿔야 한다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" />
            </intent-filter>

        </activity>

        <!-- AdMob 앱 ID (실제 값). 물결(~) 뒤가 앱 번호다 — 슬래시(/)로 된
             광고 단위 ID와 다른 값이니 섞어 넣지 말 것. 이 값이 틀리면 광고를
             켜는 순간 앱이 죽는다.
             이것만으로 실제 광고가 나가지는 않는다. 실제 광고는 VITE_ADMOB_REWARD_ID에
             진짜 광고 단위 ID가 들어가야 시작된다 (ANDROID_RELEASE.md 참고). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-9942492825878908~7836378510" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- AD_ID 권한은 여기에 없지만 AAB에는 들어간다 — AdMob SDK(play-services-ads)가
         자기 매니페스트에서 선언하고 있어 병합되기 때문이다. 실제 광고를 켜면서
         제거(tools:node="remove")를 풀었다.

         Play Console의 '광고 ID 사용'도 예여야 한다. 이 둘은 세트고, 어긋난 채로
         올리면 앱이 통째로 차단된다. -->
</manifest>
