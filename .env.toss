# 앱인토스(토스 미니앱) 빌드에서만 적용된다 — `vite build --mode toss`.
# 웹·안드로이드 빌드는 이 파일을 읽지 않는다.
#
# 비밀값이 아니라서 커밋한다. Supabase 키 같은 값은 지금처럼 .env.local에 둔다.

# 미니앱 안에서는 구글·카카오 로그인을 쓸 수 없다(토스 정책). 설정 화면이 이 값을 보고 가른다.
VITE_TOSS=1

# 인가 코드를 mTLS로 교환할 서버. 미니앱 번들은 정적 자산이라 절대 주소가 필요하다.
VITE_TOSS_LOGIN_ENDPOINT=https://web-game-ecru.vercel.app/api/toss-login

# 인앱광고 단위 그룹 ID (리워드, 보상 '생명연장 1'). 앱인토스 콘솔에서 발급받는다.
# 미니앱은 토스 앱 안의 웹뷰라 웹에서 쓰는 AdSense를 그대로 게재할 수 없다 — 이 값이
# 비어 있으면 광고를 아예 안 부르고 5초 카운트다운 스텁으로 떨어진다.
#
# 이건 운영 ID다. 테스트할 때 이대로 쓰면 정책 위반이므로, 테스트 번들은 덮어써서 만든다:
#   VITE_TOSS_AD_GROUP_ID=ait-ad-test-rewarded-id npm run build:toss
VITE_TOSS_AD_GROUP_ID=ait.v2.live.b782e083e2c0484d

# 프로모션 코드. 앱인토스 콘솔 → 프로모션에서 발급받는다.
# 비어 있으면 지급을 아예 시도하지 않는다 — 지금이 그 상태다.
#
# 2026-08-22, 첫 프로모션(01KZA8PABZ268PXHVSTVAVY7EX, 접속 20원 · 1판 30원 ·
# 누적 3판 50원, 1인 100원)을 콘솔에서 TERMINATED로 내렸다. 비가역이라 이 코드는
# 되살아나지 않는다 — 다시 하려면 프로모션을 새로 만들어 검토를 처음부터 받는다.
# 이미 설치된 번들까지 멈추는 것은 서버 쪽 스위치가 한다
# (supabase/migrations/20260822000000_promotion_end.sql).
#
# 다음 프로모션을 붙일 때: 운영 코드를 아래에 넣고, 지급 API 테스트는 TEST_ 접두사가
# 붙은 코드로 따로 빌드해서 한다 — 그쪽은 예산이 차감되지 않는다:
#   VITE_TOSS_PROMOTION_CODE=TEST_<코드> npm run build:toss
VITE_TOSS_PROMOTION_CODE=
