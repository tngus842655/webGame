# 앱인토스(토스 미니앱) 빌드에서만 적용된다 — `vite build --mode toss`.
# 웹·안드로이드 빌드는 이 파일을 읽지 않는다.
#
# 비밀값이 아니라서 커밋한다. Supabase 키 같은 값은 지금처럼 .env.local에 둔다.

# 미니앱 안에서는 구글·카카오 로그인을 쓸 수 없다(토스 정책). 설정 화면이 이 값을 보고 가른다.
VITE_TOSS=1

# 인가 코드를 mTLS로 교환할 서버. 미니앱 번들은 정적 자산이라 절대 주소가 필요하다.
VITE_TOSS_LOGIN_ENDPOINT=https://web-game-ecru.vercel.app/api/toss-login

# 인앱광고 단위 그룹 ID. 앱인토스 콘솔에서 발급받는다.
# 미니앱은 토스 앱 안의 웹뷰라 웹에서 쓰는 AdSense를 그대로 게재할 수 없다 — 이 값이
# 비어 있으면 광고를 아예 안 부르고 5초 카운트다운 스텁으로 떨어진다.
VITE_TOSS_AD_GROUP_ID=
