{
  // Cloudflare Workers 정적 자산 배포 설정
  // 자동 빌드 시 dist 위치를 추론하지 못해 실패하던 문제를 방지한다.
  "name": "webgame",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./dist",
    // SPA 라우팅: /stats, /ranking/suika 같은 주소로 직접 들어와도 index.html을 돌려준다
    "not_found_handling": "single-page-application"
  }
}
